<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.lifelately.controller.MainController" styleClass="app-root">
    <left>
        <VBox prefWidth="202.0" minWidth="190.0" styleClass="sidebar">
            <padding><Insets top="24" right="15" bottom="18" left="15"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="9" styleClass="brand-block">
                <StackPane styleClass="brand-mascot-wrap">
                    <ImageView fitWidth="42" fitHeight="42" preserveRatio="true"><image><Image url="@../images/bear/bear-default.png"/></image></ImageView>
                </StackPane>
                <VBox spacing="-2">
                    <Label text="life lately." styleClass="brand-title"/>
                    <Label text="YOUR QUIET CORNER" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>
            <Label text="YOUR SPACE" styleClass="sidebar-section-label"/>
            <VBox spacing="7" styleClass="sidebar-menu" VBox.vgrow="ALWAYS">
                <Button fx:id="homeButton" text="Home" onAction="#showHome" maxWidth="Infinity" styleClass="sidebar-item"/>
                <Button fx:id="journalButton" text="Journal" onAction="#showJournal" maxWidth="Infinity" styleClass="sidebar-item"/>
                <Button fx:id="calendarButton" text="Calendar" onAction="#showCalendar" maxWidth="Infinity" styleClass="sidebar-item"/>
                <Button fx:id="insightsButton" text="Insights" onAction="#showInsights" maxWidth="Infinity" styleClass="sidebar-item"/>
            </VBox>
            <VBox spacing="6" styleClass="sidebar-whisper">
                <Region styleClass="accent-mark"/>
                <Label text="Small moments become meaningful stories." wrapText="true" styleClass="companion-copy"/>
            </VBox>
            <Button fx:id="settingsButton" text="Settings" onAction="#showSettings" maxWidth="Infinity" styleClass="sidebar-item"/>
            <Label fx:id="databaseStatus" styleClass="database-status"/>
        </VBox>
    </left>
    <center><StackPane fx:id="contentHost" styleClass="content-host"/></center>
</BorderPane>
